{
  "name": "dustmap-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Dustmap — a report-only map of dead code, duplicates and refactor signals in a repo, built for AI agents.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "verify": "node tools/verify.mjs",
    "verify:isolation": "node tools/verify-isolation.mjs",
    "dustmap": "node packages/cli/bin/dustmap.mjs",
    "dustmap-briefs": "node packages/sink-briefs/bin/dustmap-briefs.mjs",
    "queue:next": "node tools/queue/next.mjs",
    "queue:next-bug": "node tools/queue/next.mjs --bug",
    "queue:next-epic": "node tools/queue/next-epic.mjs",
    "queue:close": "node tools/queue/close.mjs",
    "queue:validate": "node tools/queue/validate.mjs",
    "queue:selftest": "node tools/queue/validate.selftest.mjs",
    "tkr:verify": "node tools/tkr/tkr-verify.mjs",
    "tkr:status": "node tools/tkr/tkr-status.mjs",
    "target": "tsx tools/targets/run.mts",
    "target:compare": "tsx tools/targets/compare.mts",
    "verify:targets": "node tools/targets/verify-targets.mjs",
    "agent-eval": "tsx tools/agent-eval/run.mjs",
    "agent-eval:live": "tsx tools/agent-eval/run.mjs --live"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
