{
  "name": "@dustmap/sink-briefs",
  "version": "0.0.0",
  "private": true,
  "description": "Dustmap sink — turn selected findings into file-queue briefs (queue.json + markdown). Never auto-enqueues the whole report.",
  "keywords": [
    "dead-code",
    "duplicate-code",
    "code-quality",
    "refactoring",
    "mcp",
    "ai-agents",
    "typescript",
    "static-analysis"
  ],
  "author": "Mensamayne",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mensamayne/dustmap.git",
    "directory": "packages/sink-briefs"
  },
  "homepage": "https://github.com/Mensamayne/dustmap#readme",
  "bugs": {
    "url": "https://github.com/Mensamayne/dustmap/issues"
  },
  "type": "module",
  "bin": {
    "dustmap-briefs": "./bin/dustmap-briefs.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./src/main.ts",
      "default": "./src/main.ts"
    }
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dustmap/contract": "*",
    "@dustmap/core": "*"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
