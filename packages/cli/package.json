{
  "name": "@dustmap/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Dustmap CLI — init, scan, summary, show, decide, export (markdown/SARIF), ratchet.",
  "type": "module",
  "bin": {
    "dustmap": "./bin/dustmap.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./src/main.ts",
      "default": "./src/main.ts"
    }
  },
  "files": [
    "bin",
    "src",
    "agent"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dustmap/contract": "*",
    "@dustmap/core": "*"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
