{
  "name": "@dustmap/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Dustmap MCP server — summary, list, show, decide, scan for AI agents (bounded responses).",
  "keywords": [
    "dead-code",
    "duplicate-code",
    "code-quality",
    "refactoring",
    "mcp",
    "ai-agents",
    "typescript",
    "static-analysis"
  ],
  "author": "Mensamayne",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mensamayne/dustmap.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Mensamayne/dustmap#readme",
  "bugs": {
    "url": "https://github.com/Mensamayne/dustmap/issues"
  },
  "type": "module",
  "bin": {
