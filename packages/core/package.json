{
  "name": "@dustmap/core",
  "version": "0.0.0",
  "private": true,
  "description": "Dustmap scan core — config, init/detect, full/diff file sets, adapter runner, content-hash cache. Writes only under outputDir.",
  "keywords": [
    "dead-code",
    "duplicate-code",
    "code-quality",
    "refactoring",
    "mcp",
    "ai-agents",
    "typescript",
    "static-analysis"
  ],
  "author": "Mensamayne",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mensamayne/dustmap.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Mensamayne/dustmap#readme",
  "bugs": {
    "url": "https://github.com/Mensamayne/dustmap/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dustmap/contract": "*",
    "@huggingface/tokenizers": "0.2.0",
    "css-tree": "^3.2.1",
    "dependency-cruiser": "^18.6.0",
    "falsegreen-js": "^0.7.0",
    "jscpd": "^5.4.1",
    "knip": "^6.16.0",
    "minimatch": "^10.0.1",
    "onnxruntime-node": "1.30.0",
    "postcss": "^8.5.31",
    "postcss-scss": "^4.0.9",
    "typescript": "^5.8.2",
    "yaml": "^2.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "vitest": "^3.0.9",
    "@types/css-tree": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
